# Python weight Converter

weight = float(input("Enter weight : "))
unit = input("Kilogram or Pounds? (K or L): ")

if unit == "K":
    weight = weight * 2.205
    print(f"Your weight is : {weight} kg")

elif unit == "L":
    weight = weight / 2.205
    print(f"Your weight is : {weight} lbs")

else:
    print(f"{unit} was not valid")

