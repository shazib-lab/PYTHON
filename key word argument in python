


def shiping_label(*args, **kwargs):
    for arg in args:
        print(arg, end=" ")

    for value in kwargs.values():
        print(value, end=" ")
        print(f"{kwargs.get("country")}")
        print(f"{kwargs.get("city")}, {kwargs.get("zip")}")
     






