# Nested Loop: A loop within another (outer, inner)

#                 outer_loop:
#                     inner_loop:



for i in range(1, 10):
    print(i, end=",")  #  end=" " : all item will show in a one row




for i in range(3):  # under the code , how many times will continue
    for y in range(1, 10):
        print(y, end=" ")

    print()




