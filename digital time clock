# Coun down time clock

import time


# Test one----------------------------

my_time = int(input("Enter the time in second: "))

for i in range(0, my_time):
    time.sleep(1)
    print(i)
print("Times Up!!")


# Test two------------------------

my_time = int(input("Enter your time in second: "))

for i in range(my_time, 0, -1): # revers count down in time
    time.sleep(1)
    print(i)

print("TIMES UP !!")



# Final clock-------------------------

my_time = int(input("Enter your time in second: "))

for i in range(my_time, 0, -1):

    seconds = i % 60
    minutes = int( i // 60) % 60
    hours = int( i // 3600) 
    print(f"Hours: {hours:02}: Minutes: {minutes:02}: Second: {seconds:02}")
    time.sleep(1)

print("times up!!")

