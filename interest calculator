# Python compound interest calculator by using while loop.

principle = 0 
rate = 0
time = 0


while principle <= 0 :
    principle = float(input("Enter yout Amount: "))
    if principle <= 0 :
        print("Principle amount can not less than or equal to zero")

while rate <= 0:
    rate = float(input("Enter your interest rate: "))
    if rate <= 0: 
        print("Interest rate can not be less than or equal zero")

while time <= 0:
    time = int(input("Enter the time of Year: "))
    if time <=0:
        print("Time can not be less than or equal zero")

total = principle * pow(1 + rate /100, time)

print(f"Balance after {time} years is : {round(total, 3)}")

