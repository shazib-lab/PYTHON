# Evaluate multiple condition (or, and, not)

# or = at least one condition must be true

# and = both  condition must be true

# not = inverts the condition (no false, not True)


#------------ OR ---------

temp = 20
is_raining = False

if temp > 25 or is_raining:
    print("The outdoor even is cancelled")
else:
    print("The outdoor event is still schedule")


