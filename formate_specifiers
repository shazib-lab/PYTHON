# FORMATE SPECIFERS: { value : flags } formate a value based on what flags are shorted.

# (number) f = round to that many decimal places (fixed point)
# (number) = allocate that many spaces
# : 03 = allocate and zero pad that many
# : < = left justify
# : > = right justify
# : ^ = center justify
# : + = use a plus sign to indicate positive vlaue
# : = = palce sign to leftmost pofitive
# :  = insert a spaces before positive number 
# : , = comma separator



price1 = 3.134
price2 = -987.65
money = 123456789.99

print(f"{price1:.2f}")        # 3.13
print(f"{price1:10}")         # Width 10
print(f"{price1:010}")        # Zero padding
print(f"{price1:<10}")        # Left
print(f"{price1:>10}")        # Right
print(f"{price1:^10}")        # Center
print(f"{price1:+}")          # +3.134
print(f"{price2:=015}")       # -00000987.65
print(f"{price1: }")          # Leading space
print(f"{money:,.2f}")        # 123,456,789.99
