# List comprehension : A concise way to create lists in python compact
#           and easier to read than traditional loops [EXPRESSION for value in iterable if condition]

doublse = []

for i in range(1,11):
    doublse.append(i*2)
print(doublse)

doublse = [i*2 for i in range(1,11) ]

print(doublse)


triplse = [y*3 for y in range(1,11)]
print(triplse)





fruits = ['apple', 'orange', 'banana']

fruit = [fruit.upper() for fruit in fruits]
print(fruit)


fruits_char = [fruit[0] for fruit in fruits]
print(fruits_char)



#---------------- number ------

numbers = [1, -2, 3, -4, 5, -6]

positive_number = [num for num in numbers if num>=0]
print(positive_number)

negative_number = [neg for neg in numbers if neg <0]
print(negative_number)

even_number= [even for even in numbers if even % 2 == 0]
print(even_number)

odd_numer = [odd for odd in numbers if odd % 2 == 1]
print(odd_numer)



