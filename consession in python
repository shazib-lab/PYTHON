menu = { "pizza": 3.00,
        "burger": 4.50,
        "halua": 5.00,
        "lemon": 2.50,
        }
cart = []
total = 0

print("--------------- menu -------------")
print()

for key, value in menu.items():
    print(f"{key:10}:  {value:.2f} tk")
print()
print("------------------------------------")

while True:
    food = input("Enter an item to buy you (q to quite): ").lower()
    if food == "q":
        break
    elif menu.get(food) is  not None:
        cart.append(food)

print("------------ Your Order ------------------")
for food in cart:
    total += menu.get(food)
    print(food, end=" ")

print()
print(f"Total is : {total:.2f} tk")
